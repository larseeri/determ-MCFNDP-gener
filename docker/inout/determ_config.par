maxNbSnk 3 // ignored since oneSrcOneSnk
minFixCos 100
maxFixCos 100
minVarCos 10
maxVarCos 10
minComVol 200
maxComVol 200
minArcCap 100
maxArcCap 100
minComCap 100
maxComCap 100
